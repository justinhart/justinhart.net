<article class="video-card" id="video-{{ v.id }}">
  <p class="media-meta">{{ v.dateKind }} {{ v.displayDate }} · {{ v.channel }}</p>
  <h3 id="title-{{ v.id }}">{{ v.title }}</h3>
  <p class="video-description">{{ v.description }}</p>
  <div class="video-actions">
    {% if v.embedAllowed %}
      <button type="button" class="video-view" hidden
        aria-expanded="false" aria-controls="player-{{ v.id }}"
        aria-label="View: {{ v.title }}"
        data-video-title="{{ v.title }}"
        data-video-src="{% if v.vimeoId %}https://player.vimeo.com/video/{{ v.vimeoId }}?dnt=1{% else %}https://www.youtube-nocookie.com/embed/{{ v.youtubeId }}{% endif %}">
        <span class="video-view-icon" aria-hidden="true">&#9654;&#65038;</span>
        <span class="video-view-label">View</span>
      </button>
    {% endif %}
    <a href="{{ v.url }}" target="_blank" rel="noopener noreferrer"
      aria-label="Watch {{ v.title }} on {% if v.vimeoId %}Vimeo{% else %}YouTube{% endif %} (opens a new tab)">{% if v.vimeoId %}Vimeo{% else %}YouTube{% endif %} <span aria-hidden="true">↗</span></a>
    {% if v.sourceUrl %}<a href="{{ v.sourceUrl }}">Event / project</a>{% endif %}
    {% for key in v.paperKeys %}
      <a href="/publications/#{{ key }}">{% if loop.length > 1 %}Related publication {{ loop.index }}{% else %}Related publication{% endif %}</a>
    {% endfor %}
  </div>
  {% if v.embedAllowed %}
    <div class="video-frame" id="player-{{ v.id }}" role="region" aria-labelledby="title-{{ v.id }}" hidden></div>
  {% endif %}
</article>
